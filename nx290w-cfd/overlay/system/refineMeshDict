FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      refineMeshDict;
}

coordinates
{
    type        global;
    e1          (1 0 0);
    e2          (0 1 0);
    directions  (e1 e2);
}

// Six nested x-y refinement levels, mirrored across y=0 for the full trimaran.
// Water enters from +x; the boxes extend progressively farther downstream (-x).
zones
{
    level1
    {
        type    box;
        box     (-13 -6 -3) (7 6 3);
    }
    level2
    {
        type    box;
        box     (-8 -3 -2.5) (6 3 2);
    }
    level3
    {
        type    box;
        box     (-6 -1.5 -1) (5 1.5 1.5);
    }
    level4
    {
        type    box;
        box     (-5 -1 -0.6) (4 1 1);
    }
    level5
    {
        type    box;
        box     (-4 -0.75 -0.3) (3.5 0.75 0.8);
    }
    level6
    {
        type    box;
        box     (-3.5 -0.68 -0.15) (3.25 0.68 0.65);
    }
}
